generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Property {
  id                  String   @id @default(cuid())
  title               String   // Nombre proyecto
  description         String?  // DescripciÃ³n (html/rich text)
  propertyType        String   // Tipo (Casas, Departamento, Terrenos)
  operation           String   // OperaciÃ³n (Venta, Arriendo)
  isTemporaryRent     Boolean  @default(false) // Arriendo Temporal
  status              String?  // Status (Usada, Nueva)
  city                String   // Ciudad
  sector              String   // Sector
  address             String?  // DirecciÃ³n
  googleMapsLink      String?
  
  currency            String   @default("UF") // Valorado en (UF, Pesos, Dolar)
  price               Float    // Valor
  beds                Int      @default(0) // Habitaciones
  baths               Int      @default(0) // Wc
  landArea            Float?   // Metros terreno / totales
  builtArea           Float?   // Metros construido / Ãºtiles
  parking             Int?     @default(0) // Estacionamiento
  storage             Int?     @default(0) // Bodega
  isGreenProject      Boolean  @default(false) // Proyecto En Verde
  salesRoom           String?  // Sala de venta (html)
  executive           String?  // Ejecutivo Piloto (html)
  publishedState      String   @default("Publicado") // Estado (Borrador, Publicado)
  images              String[] // GalerÃ­a
  blueprints          String[] // Planos
  featured            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SiteContent {
  id          String   @id @default(cuid())
  key         String   @unique // Identificador Ãºnico (ej: "quienes_somos", "contacto_talca")
  title       String   // TÃ­tulo a mostrar en el panel
  content     String   // Contenido rico (HTML o texto largo)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PublicationRequest {
  id           String   @id @default(cuid())
  name         String
  phone        String
  email        String
  propertyType String
  operation    String
  message      String
  status       String   @default("Pendiente") // Pendiente, Contactado, Descartado
  createdAt    DateTime @default(now())
}

model HeroImage {
  id        String   @id @default(cuid())
  url       String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Office {
  id        String   @id @default(cuid())
  name      String   // ej: "Santiago" o "Talca"
  address   String   // ej: "El Golf 40..."
  email     String?  // ej: "contacto@nys.cl"
  phone     String?  // ej: "+56 9 9289 3145"
  mapLink   String?  // Enlace de Google Maps
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
