generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Property {
  id                  String   @id @default(cuid())
  title               String   // Nombre proyecto
  description         String?  // DescripciÃ³n (html/rich text)
  propertyType        String   // Tipo (Casas, Departamento, Terrenos)
  operation           String   // OperaciÃ³n (Venta, Arriendo)
  isTemporaryRent     Boolean  @default(false) // Arriendo Temporal
  status              String?  // Status (Usada, Nueva)
  city                String   // Ciudad
  sector              String   // Sector
  address             String?  // DirecciÃ³n
  googleMapsLink      String?
  
  currency            String   @default("UF") // Valorado en (UF, Pesos, Dolar)
  price               Float    // Valor
  beds                Int      @default(0) // Habitaciones
  baths               Int      @default(0) // Wc
  landArea            Float?   // Metros terreno / totales
  builtArea           Float?   // Metros construido / Ãºtiles
  parking             Int?     @default(0) // Estacionamiento
  storage             Int?     @default(0) // Bodega
  isGreenProject      Boolean  @default(false) // Proyecto En Verde
  salesRoom           String?  // Sala de venta (html)
  executive           String?  // Ejecutivo Piloto (html)
  publishedState      String   @default("Publicado") // Estado (Borrador, Publicado)
  images              String[] // GalerÃ­a
  blueprints          String[] // Planos
  featured            Boolean  @default(false)
  isAvailable         Boolean  @default(true) // Disponibilidad
  availabilityStatus  String   @default("Disponible") // Disponible, No Disponible, Arrendada, Vendida, Reservada
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SiteContent {
  id          String   @id @default(cuid())
  key         String   @unique // Identificador Ãºnico (ej: "quienes_somos", "contacto_talca")
  title       String   // TÃ­tulo a mostrar en el panel
  content     String   // Contenido rico (HTML o texto largo)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PublicationRequest {
  id           String   @id @default(cuid())
  name         String
  phone        String
  email        String
  propertyType String
  operation    String
  message      String
  status       String   @default("Pendiente") // Pendiente, Contactado, Descartado
  createdAt    DateTime @default(now())
}

model HeroImage {
  id        String   @id @default(cuid())
  url       String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Office {
  id        String   @id @default(cuid())
  name      String   // ej: "Santiago" o "Talca"
  address   String   // ej: "El Golf 40..."
  email     String?  // ej: "contacto@nys.cl"
  phone     String?  // ej: "+56 9 9289 3145"
  mapLink   String?  // Enlace de Google Maps
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientUser {
  id           String           @id @default(cuid())
  name         String
  rut          String?          @unique
  email        String?          @unique
  username     String?          @unique
  password     String
  phone        String?
  isActive     Boolean          @default(true)
  notes        String?
  documents    ClientDocument[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model ClientDocument {
  id          String     @id @default(cuid())
  clientId    String
  client      ClientUser @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  category    String     @default("Documento")
  fileUrl     String
  fileSize    String?
  fileType    String     @default("PDF")
  isExternal  Boolean    @default(false)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model AdminRole {
  id          String      @id @default(cuid())
  name        String      @unique // "Superadmin", "Comercial", "Contabilidad", etc.
  description String?
  isSystem    Boolean     @default(false) // Superadmin no se puede eliminar ni renombrar
  permissions Json        // Objeto JSON con la matriz de permisos por módulo
  users       AdminUser[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model AdminUser {
  id                String     @id @default(cuid())
  email             String     @unique
  name              String
  passwordHash      String
  roleId            String
  role              AdminRole  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  isActive          Boolean    @default(true)
  customPermissions Json?      // Excepciones individuales (override permisos del rol)
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model OwnerCompany {
  id            String          @id @default(cuid())
  code          String          @unique // "JR", "BC", "GP", "JFR", "RB", "AMB"
  name          String          // "Jose Retamal", "Buses Cipreses", etc.
  rut           String?         // "10.943.065-K"
  landlordName  String?         // "Patricia Retamal Bustos" / "José Manuel Retamal Bustos"
  address       String?         // "1 Sur Nº 885 Talca"
  phone         String?         // "+56 9 98859496"
  email         String?         // "administracion@sunrisechile.cl"
  contracts     RentalContract[]
  vouchers      LeaseVoucher[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model RentalContract {
  id                    String        @id @default(cuid())
  companyId             String?
  company               OwnerCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  newAssignee           String?       // "Patricia Retamal", "Jose Manuel Retamal", etc.
  building              String        // "AMALFI", "LIBERTADOR", "COSTA AZUL", etc.
  unitNumber            String        // "E-502", "1316", "708", etc.
  propertyType          String        @default("Departamento") // "Departamento", "Casas", "Bodega", "Estacionamiento", "Local Comercial"
  rol                   String?       // "491-022", "1193-213", etc.
  address               String?       // Dirección específica (ej. "1 Poniente Nº 635 Talca")
  storageNumber         String?       // Bodega N°
  parkingNumber         String?       // Estacionamiento N°
  contractDate          String?       // Fecha Contrato (texto o ISO)
  renewalPeriod         String?       // "6 MESES", "1 AÑO", etc.
  status                String        @default("Ocupado") // "Ocupado", "Disponible", "Vendido", "En Retiro"
  
  // Datos del arrendatario
  tenantName            String        // Nombre arrendatario
  tenantRut             String?       // RUT arrendatario
  tenantPhone           String?       // Teléfono
  tenantEmail           String?       // Correo
  otherContactInfo      String?       // Otros datos
  guarantorRelation     String?       // Relación con arrendatario (Aval, Esposa, Hija, etc.)
  guarantorPhone        String?       // Teléfono contacto
  guarantorEmail        String?       // Correo contacto
  
  // Valores base vigentes
  baseRent              Float         @default(0) // Valor arriendo base
  adjustmentPercentage  Float         @default(0) // % reajuste (ej: 0.035)
  adjustmentAmount      Float         @default(0) // Monto reajuste $
  totalRent             Float         @default(0) // Valor T / Arriendo final calculado
  guaranteeAmount       Float?        // Garantía contractual
  expensesCharge        Float?        // Gastos Comunes Cargo
  expensesPayment       Float?        // Gastos Comunes Abono
  previousRent          Float?        // Arriendo anterior
  
  vouchers              LeaseVoucher[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model LeaseVoucher {
  id                String         @id @default(cuid())
  contractId        String
  contract          RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  companyId         String?
  company           OwnerCompany?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  
  // Período y numeración
  month             String         // "ENERO", "FEBRERO", ..., "OCTUBRE", etc.
  year              Int            @default(2026)
  receiptNumber     String?        // N° de Recibo (ej. "505", "14701", etc.)
  invoiceNumber     String?        // N° de Factura si aplica
  
  // Valores financieros del mes
  baseRent          Float          @default(0)
  adjustmentPercent Float          @default(0)
  adjustmentAmount  Float          @default(0)
  totalRent         Float          @default(0) // Monto final arriendo del mes
  guaranteeAmount   Float?         // Monto garantía si se cobra este mes
  expensesCharge    Float?         // Gastos Comunes Cargo
  expensesPayment   Float?         // Gastos Comunes Abono
  previousRent      Float?         // Arriendo anterior
  totalMonth        Float          @default(0) // Total liquidado (arriendo + garantía + extras)
  amountInWords     String?        // "DOSCIENTOS NOVENTA Y TRES MIL QUINIENTOS PESOS"
  
  // Estado de recaudación y pagos
  paymentStatus     String         @default("Pendiente") // "Pagado", "Pendiente", "Saldo a Favor", "Nulo"
  paymentDate       String?        // Fecha de ingreso o pago
  transferAmount    Float          @default(0)
  cashAmount        Float          @default(0)
  depositAmount     Float          @default(0)
  accountsReceivable Float         @default(0) // Cuentas por cobrar
  collectedAmount   Float          @default(0) // Total Recaudación
  bank              String?        // "ITAU", "SANTANDER", etc.
  pendingBalance    Float          @default(0) // Saldo pendiente
  comment           String?        // Comentarios o notas
  paymentMethod     String         @default("Transferencia") // "Transferencia", "Efectivo", "Documento"
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}


